function TimelineItem({ period, index }: { period: any; index: number }) {
  const [isOpen, setIsOpen] = useState(false);

  return (
    <div className="relative pl-8 sm:pl-12">
      {/* Vertical Line */}
      <div
        className="absolute left-0 top-0 h-full w-px bg-gradient-to-b from-transparent via-border to-transparent"
        aria-hidden="true"
      />

      {/* Period Marker */}
      <div className="absolute left-[-8px] top-0 h-4 w-4 rounded-full border-2 border-background bg-[var(--crew-accent-gold)] shadow-[0_0_0_2px_var(--crew-accent-gold)] sm:left-[-12px]">
        <div className="absolute inset-0 animate-ping rounded-full bg-[var(--crew-accent-gold)] opacity-40" />
      </div>

      <div className={`group relative rounded-2xl border transition-all duration-500 ${isOpen ? 'border-[var(--crew-accent-gold)] bg-card shadow-lg' : 'border-border/60 bg-card/40 hover:border-[var(--crew-border-hover)]'}`}>
        <div
          className="cursor-pointer flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:gap-6"
          onClick={() => setIsOpen(!isOpen)}
        >
          <div className="flex shrink-0 items-center gap-3">
            <span className={`flex h-8 w-8 items-center justify-center rounded-lg text-xs font-bold tabular-nums transition-colors duration-300 ${isOpen ? 'bg-[var(--crew-accent-gold)] text-background' : 'bg-[var(--brand-sunburst-soft)] text-[var(--crew-accent-gold)]'}`}>
              {String(index + 1).padStart(2, '0')}
            </span>
            <p className={`text-[10px] font-bold uppercase tracking-[0.1em] transition-colors duration-300 ${isOpen ? 'text-foreground' : 'text-[var(--crew-accent-gold)]'}`}>
              {period.era}
            </p>
          </div>

          <div className="flex-1">
            <h3 className={`text-base font-bold transition-colors duration-300 ${isOpen ? 'text-foreground' : 'text-foreground group-hover:text-[var(--crew-accent-gold)]'}`}>
              {period.title}
            </h3>
            <p className="mt-1 text-sm leading-relaxed text-muted-foreground line-clamp-2">
              {period.summary}
            </p>
          </div>

          <div className={`flex shrink-0 items-center justify-center rounded-full border border-border p-1 text-muted-foreground transition-all duration-300 ${isOpen ? 'rotate-90 border-[var(--crew-accent-gold)] text-[var(--crew-accent-gold)]' : ''}`} aria-hidden="true">
            <ChevronRight className="h-4 w-4" />
          </div>
        </div>

        {isOpen && (
          <div className="animate-in fade-in slide-in-from-top-2 duration-300 border-t border-border/60 p-5">
            <div className="grid gap-6 lg:grid-cols-2">
              <div className="space-y-3">
                <p className="text-sm leading-relaxed text-muted-foreground">
                  {period.summary}
                </p>
                <ul className="space-y-2">
                  {period.points.map((point: string, idx: number) => (
                    <li key={idx} className="flex gap-3 text-xs leading-relaxed text-muted-foreground">
                      <span className="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--crew-accent-gold)]" />
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>

              {period.image_url && (
                <div className="relative aspect-video overflow-hidden rounded-xl border border-border bg-muted">
                  <SafeImage
                    src={period.image_url}
                    alt={period.image_alt || period.title}
                    className="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
                  />
                  {period.image_credit && (
                    <span className="absolute bottom-2 right-2 rounded bg-black/60 px-1.5 py-0.5 text-[9px] text-white/80 backdrop-blur-sm">
                      {period.image_credit}
                    </span>
                  )}
                </div>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

