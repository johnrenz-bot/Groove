# ==============================================================================
# Groove System — Environment Variables Configuration
# Copy this file to `.env.local` for local development
# ==============================================================================

# Supabase Public Configuration (Safe for Client Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenRouter / DeepSeek AI Assistant (Server-side API routes)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=deepseek/deepseek-chat

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Administration (Server-Side Only)
# The single address allowed to hold the `admin` role. `lib/admin/access.ts`
# reads this and falls back to admin@gmail.com when unset; the same value is
# mirrored in supabase/admin_hardening.sql, so changing it needs a migration.
ADMIN_EMAIL=admin@gmail.com
# Admin password used by the seeded administrator account.
ADMIN_PASSWORD=
# Six-digit second factor for /admin/verify-passcode. When unset, that page
# explains it is not configured instead of accepting any six digits.
ADMIN_PASSCODE=

# GrooveyAI Performing Arts Coach (Server-Side Only - Google Gemini API)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# GrooveyAI Optional Fallbacks (Server-Side Only)
GROQ_API_KEY=your-groq-api-key

# DanceBeat AI Agent & Dance Community Pipeline (Server-Side Only)
ANTHROPIC_API_KEY=your-anthropic-api-key
INGEST_API_KEY=your-secure-ingest-api-key
CRON_SECRET=your-secure-cron-secret

# Resend Transactional Email (Server-Side Only)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# Sender address:
# NOTE: "onboarding@resend.dev" is Resend's default test address; on free/testing tiers it can ONLY deliver
# to the account owner's own email. For production to all users, verify a custom domain at https://resend.com/domains
# and set an address on that domain (e.g., "GroovePH <hello@yourdomain.com>").
RESEND_FROM_ADDRESS=GroovePH <onboarding@resend.dev>

# Supabase Auth Custom SMTP (Configure in Supabase Dashboard > Authentication > SMTP Settings):
# Host: smtp.resend.com
# Port: 465 (SSL) or 587 (TLS)
# User: resend
# Pass: <your-resend-api-key>
# Sender Email: your verified domain sender (e.g. noreply@yourdomain.com)


# Google Maps (browser-side; restrict this key by HTTP referrer and API)
# Enable: Maps JavaScript API + Places API (New), and enable billing on the project.
# Create a vector Map ID for production; DEMO_MAP_ID is the development fallback.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_ACTUAL_API_KEY
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=YOUR_MAP_ID

# Google Places discovery (SERVER-SIDE ONLY - optional override)
# `/api/studios` reads GOOGLE_PLACES_API_KEY first, then GOOGLE_MAPS_API_KEY, then
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY. Set this only when you want a separate,
# server-restricted key. Enable "Places API (New)" on the key and allow it to be
# called from the server (no HTTP referrer restriction).
GOOGLE_PLACES_API_KEY=
