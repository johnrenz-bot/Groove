# ==============================================================================
# Groove System — Environment Variables Configuration
# Copy this file to `.env.local` for local development
# ==============================================================================

# Supabase Public Configuration (Safe for Client Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenRouter / DeepSeek AI Assistant (Server-side API routes)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=deepseek/deepseek-chat

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Administration (Server-Side Only)
# The single address allowed to hold the `admin` role. `lib/admin/access.ts`
# reads this and falls back to admin@gmail.com when unset; the same value is
# mirrored in supabase/admin_hardening.sql, so changing it needs a migration.
ADMIN_EMAIL=admin@gmail.com
# Admin password used by the seeded administrator account.
ADMIN_PASSWORD=
# Six-digit second factor for /admin/verify-passcode. When unset, that page
# explains it is not configured instead of accepting any six digits.
ADMIN_PASSCODE=

# GrooveyAI Performing Arts Coach (Server-Side Only - Google Gemini API)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# GrooveyAI Optional Fallbacks (Server-Side Only)
GROQ_API_KEY=your-groq-api-key

# DanceBeat AI Agent & Dance Community Pipeline (Server-Side Only)
ANTHROPIC_API_KEY=your-anthropic-api-key
INGEST_API_KEY=your-secure-ingest-api-key
CRON_SECRET=your-secure-cron-secret

